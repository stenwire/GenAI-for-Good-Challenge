 {
  "id": "dev-042",
  "qtype": "count",
  "question": "How many tree records are in tpo-trees.csv?",
  "steps": [
   {
    "op": "count_rows",
    "args": {
     "source_id": "SRC_013eda19f72a"
    },
    "save_as": "n"
   }
  ]
 },
 {
  "id": "dev-043",
  "qtype": "data_quality",
  "question": "How many tree records in tpo-trees.csv have no confirmed-date, and what share is that?",
  "steps": [
   {
    "op": "count_nulls",
    "args": {
     "source_id": "SRC_013eda19f72a",
     "columns": [
      "confirmed-date"
     ]
    },
    "save_as": "nulls"
   },
   {
    "op": "share",
    "args": {
     "part": "$nulls.confirmed-date.blank",
     "total": "$nulls.total"
    },
    "save_as": "pct"
   }
  ]
 },
