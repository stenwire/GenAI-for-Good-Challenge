[
 {
  "id": "dev-001",
  "qtype": "compare",
  "question": "How do North West's bus passenger journeys in the year ending March 2025 compare with the year ending March 2019, as a percentage of the 2019 total?",
  "steps": [
   {
    "op": "cell_lookup",
    "args": {
     "source_id": "SRC_f9068c4ee468",
     "sheet": "BUS01a",
     "row": "2025",
     "column": "North West"
    },
    "save_as": "y2025"
   },
   {
    "op": "cell_lookup",
    "args": {
     "source_id": "SRC_f9068c4ee468",
     "sheet": "BUS01a",
     "row": "2019",
     "column": "North West"
    },
    "save_as": "y2019"
   },
   {
    "op": "share",
    "args": {
     "part": "$y2025",
     "total": "$y2019",
     "label": "2025 as % of 2019"
    },
    "save_as": "pct"
   }
  ]
 },
 {
