 {
  "id": "dev-051",
  "qtype": "lookup",
  "question": "When was TPO401 made and confirmed, and how many days passed between them?",
  "steps": [
   {
    "op": "lookup_row",
    "args": {
     "source_id": "SRC_5b6ce878f23c",
     "key_column": "reference",
     "value": "TPO401",
     "columns": [
      "made_date",
      "confirmed_date"
     ]
    },
    "save_as": "order"
   },
   {
    "op": "date_diff",
    "args": {
     "start": "$order.made_date",
     "end": "$order.confirmed_date"
    },
    "save_as": "days"
   }
  ]
 },
 {
